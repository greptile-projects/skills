#!/bin/sh
# greptile-pre-push-hook v1
# Blocks pushes unless the current commit has a Greptile confidence score at
# or above MIN_CONFIDENCE. Bypass once with git push --no-verify.
MIN_CONFIDENCE=5 # baked by installer; runtime override: GREPTILE_MIN_CONFIDENCE=<1-5>

set -u

# --- output ------------------------------------------------------------------

GREEN=''; DIM=''; RED=''; RESET=''; INTERACTIVE=0
if [ -t 2 ] && [ "${TERM:-}" != "dumb" ]; then
  INTERACTIVE=1
fi
if [ "$INTERACTIVE" = 1 ] && [ -z "${NO_COLOR:-}" ]; then
  GREEN='\033[38;2;40;233;159m'
  DIM='\033[2m'; RED='\033[31m'; RESET='\033[0m'
fi

say() { printf '%b\n' "$*" >&2; }

row() {
  printf '  %b%-12s%b%s\n' "$DIM" "$1" "$RESET" "$2" >&2
}

notice() {
  say "${DIM}[greptile] $1${RESET}"
}

tips() {
  say ""
  if [ "$1" = "blocked" ]; then
    say "${DIM}  tip: bypass once with git push --no-verify${RESET}"
    _tip_indent='       '
  else
    _tip_indent='  tip: '
  fi
  if [ -n "${JSON_RUN_ID:-}" ]; then
    say "${DIM}${_tip_indent}view again with greptile review show $JSON_RUN_ID [--json]${RESET}"
  fi
  say ""
}

block() {
  _message=$1
  shift
  say ""
  say "${DIM}[greptile]${RESET} ${RED}${_message}${RESET}"
  while [ $# -gt 0 ]; do
    say "$1"
    shift
  done
  tips blocked
  exit 1
}

pass() {
  _confidence=$1
  _count=$2
  if [ "$_count" -gt 0 ] 2>/dev/null; then
    _findings=$_count
  else
    _findings=none
  fi
  say ""
  say "${DIM}[greptile]${RESET} ${GREEN}review passed${RESET}"
  row "Confidence" "$_confidence/5"
  row "Findings" "$_findings"
  row "Wrote" "$DISPLAY_JSON_PATH"
  tips passed
}

# --- JSON --------------------------------------------------------------------

if command -v node >/dev/null 2>&1; then
  JSON_PARSER=node
elif command -v jq >/dev/null 2>&1; then
  JSON_PARSER=jq
else
  JSON_PARSER=''
fi

# Sets confidence, finding count, and run ID from a review status file.
parse_json() {
  _file=$1
  case "$JSON_PARSER" in
    node)
      _values=$(node -e '
        const j=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
        console.log([j.confidence??"",j.commentCount??0,j.runId??""].join("|"));
      ' "$_file" 2>/dev/null) || return 1
      ;;
    jq)
      _values=$(jq -r '[.confidence // "", .commentCount // 0, .runId // ""] | @tsv' "$_file" 2>/dev/null | tr '\t' '|') || return 1
      ;;
    *) return 1 ;;
  esac

  _old_ifs=$IFS
  IFS='|'
  # shellcheck disable=SC2086
  set -- $_values
  IFS=$_old_ifs
  JSON_CONFIDENCE=${1:-}
  JSON_COUNT=${2:-0}
  JSON_RUN_ID=${3:-}
}

# --- configuration -----------------------------------------------------------

if [ "${GREPTILE_SKIP_REVIEW:-}" = "1" ]; then
  notice "skipped: GREPTILE_SKIP_REVIEW=1 set."
  exit 0
fi

min=$MIN_CONFIDENCE
if [ -n "${GREPTILE_MIN_CONFIDENCE:-}" ]; then
  case "$GREPTILE_MIN_CONFIDENCE" in
    [1-5]) min=$GREPTILE_MIN_CONFIDENCE ;;
    *) notice "ignoring invalid GREPTILE_MIN_CONFIDENCE='$GREPTILE_MIN_CONFIDENCE'; using $MIN_CONFIDENCE." ;;
  esac
fi

# --- pushed commit -----------------------------------------------------------
# stdin: <local ref> <local sha> <remote ref> <remote sha>

head_sha=$(git rev-parse HEAD 2>/dev/null || true)
push_sha=''
unreviewable=''
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [ -n "$local_ref" ] || continue
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac
  # Peel annotated tags to the commit they carry; skip refs with no commits.
  commit_sha=$(git rev-parse --verify --quiet "$local_sha^{commit}" 2>/dev/null) || continue
  if [ -n "$head_sha" ] && [ "$commit_sha" = "$head_sha" ]; then
    push_sha=$head_sha
  else
    _name=${local_ref#refs/heads/}
    _name=${_name#refs/tags/}
    unreviewable="$unreviewable $_name"
  fi
done

# Only the checked-out commit can be reviewed, so refs that do not match it
# would reach the remote unreviewed. Block instead of waving them through.
if [ -n "$unreviewable" ]; then
  block "cannot review refs other than the checked-out HEAD; push blocked." \
    "  Unreviewed:$unreviewable" \
    "  Check out each ref's commit and push it on its own."
fi
if [ -z "$push_sha" ]; then
  notice "skipped: nothing to review in this push."
  exit 0
fi

# --- files and helpers -------------------------------------------------------

gdir=$(git rev-parse --path-format=absolute --git-path greptile 2>/dev/null) \
  || gdir="$(git rev-parse --absolute-git-dir)/greptile"
mkdir -p "$gdir"
JSON_PATH="$gdir/last-review.json"
DISPLAY_JSON_PATH=$(git rev-parse --git-path greptile/last-review.json 2>/dev/null || printf '%s' "$JSON_PATH")
STATUS_PATH="$gdir/last-review.status.tmp"

# shellcheck disable=SC2329 # invoked by trap
cleanup() {
  rm -f "$STATUS_PATH"
}
trap cleanup EXIT
# Exit non-zero so git aborts the push; the EXIT trap handles cleanup.
trap 'exit 130' INT TERM

save_status() {
  mv "$STATUS_PATH" "$JSON_PATH"
}

finish() {
  case "$JSON_CONFIDENCE" in
    [1-5]) ;;
    *) block "review returned no confidence score; push blocked." "Wrote: $DISPLAY_JSON_PATH" ;;
  esac

  if [ "$JSON_CONFIDENCE" -ge "$min" ]; then
    pass "$JSON_CONFIDENCE" "$JSON_COUNT"
    exit 0
  fi
  say ""
  say "${DIM}[greptile]${RESET} ${RED}push blocked${RESET}"
  row "Confidence" "$JSON_CONFIDENCE/5 (requires $min/5)"
  row "Findings" "$JSON_COUNT"
  row "Wrote" "$DISPLAY_JSON_PATH"
  tips blocked
  exit 1
}

read_status() {
  greptile review status --commit "$push_sha" --json >"$STATUS_PATH" 2>/dev/null
  STATUS_RC=$?
  if [ "$STATUS_RC" -eq 0 ]; then
    parse_json "$STATUS_PATH" || block "could not read review status; push blocked."
  else
    JSON_CONFIDENCE=''; JSON_COUNT=0; JSON_RUN_ID=''
  fi
}

run_review() {
  if [ "$1" = "resume" ]; then
    _display='greptile review --resume'
    set -- --resume
  else
    _display='greptile review'
    set --
  fi

  if [ "$INTERACTIVE" != 1 ]; then
    _display="$_display --json"
    set -- "$@" --json
  fi
  say ""
  say "${DIM}[greptile] \$${RESET} $_display"
  if [ "$INTERACTIVE" = 1 ]; then
    # Let the CLI own the terminal and render its final report and diagrams.
    greptile review "$@" </dev/null
  else
    # In logs and CI, keep the full payload out of the hook output. The compact
    # status snapshot below is the durable result used by the gate.
    greptile review "$@" </dev/null >/dev/null
  fi
  _rc=$?
  [ "$_rc" -eq 0 ] || block "review failed (exit code $_rc); push blocked."
}

# --- review ------------------------------------------------------------------

command -v greptile >/dev/null 2>&1 \
  || block "Greptile CLI not found; push blocked." "Install it with: npm i -g greptile"
[ -n "$JSON_PARSER" ] \
  || block "node or jq is required to read review results; push blocked."

if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
  notice "uncommitted changes will not be reviewed or pushed."
fi

# The CLI owns review history. Reuse a completed review for this exact commit,
# resume one already running, or start a new review.
read_status
if [ "$STATUS_RC" -eq 0 ]; then
  notice "using existing review for this commit."
  save_status
  finish
fi

# A completed review gates any push by commit, but starting one needs a
# checked-out branch for the CLI to diff against a base.
if [ -z "$(git branch --show-current 2>/dev/null)" ]; then
  block "no completed review for this commit, and one cannot start from a detached HEAD; push blocked." \
    "Check out a branch and push again."
fi

resume=0
[ "$STATUS_RC" -eq 3 ] && resume=1

if [ "${GREPTILE_AUTO_REVIEW:-}" != "1" ] && [ "$INTERACTIVE" = 1 ] && [ -e /dev/tty ]; then
  printf '%b' "${DIM}[greptile]${RESET} Review before push? ${DIM}(Y/n)${RESET} " >&2
  answer=''
  read -r answer </dev/tty 2>/dev/null || answer=''
  case "$answer" in
    [Nn]*) block "review declined; push blocked." ;;
  esac
fi

if [ "$resume" = 1 ]; then
  run_review resume
else
  run_review new
fi

read_status
[ "$STATUS_RC" -eq 0 ] \
  || block "could not load completed review (exit code $STATUS_RC); push blocked."
save_status
finish
